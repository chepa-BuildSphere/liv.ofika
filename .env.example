# Ofika Delivery — variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs.
# .env.local n'est JAMAIS commité (voir .gitignore).

# ─── Neon (rempli automatiquement par `neon checkout <branche>` ou `neon env pull`) ───
# URL poolée : pour l'application
DATABASE_URL=postgresql://USER:MOT_DE_PASSE@HOTE-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
# URL directe : pour les migrations (drizzle-kit)
DATABASE_URL_UNPOOLED=postgresql://USER:MOT_DE_PASSE@HOTE.REGION.aws.neon.tech/neondb?sslmode=verify-full
NEON_BRANCH=dev
NEON_BRANCH_ID=br-xxxxxxxx-xxxxxxxx
NEON_FUNCTION_HOST_SUFFIX=.compute.c-XX.REGION.aws.neon.tech
NEON_REALTIME_URL=wss://...
# Secret : sert à sceller les requêtes Realtime. Jamais côté navigateur.
NEON_REALTIME_SECRET=

# ─── Application ───
# URL publique du site (liens envoyés aux destinataires, QR codes, webhooks)
APP_URL=http://localhost:5000

# Clé de chiffrement (AES-256-GCM) des secrets stockés en base, ex. secret webhook.
# 32 octets en base64. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠ La changer rend illisibles les secrets déjà chiffrés.
ENCRYPTION_KEY=
